PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
CLIENT_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,https://gomrok.org,https://www.gomrok.org
JWT_SECRET=replace-with-at-least-32-random-characters
STEP_UP_SECRET=replace-with-a-different-at-least-32-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
